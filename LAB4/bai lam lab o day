--câu 1
SELECT category_id,
       MAX(list_price) AS max_price,
       MIN(list_price) AS min_price
  FROM [BikeStores].[production].[products]
GROUP BY category_id
HAVING MAX(list_price) > 4000
   AND MIN(list_price) < 500;
  --câu 2
SELECT category_id,
       AVG(list_price) AS avg_price
  FROM [BikeStores].[production].[products]
GROUP BY category_id
HAVING AVG(list_price) BETWEEN 500 AND 1000;
--câu 3
SELECT order_id,
       quantity,
       list_price,
       discount,
       quantity * list_price * (1 - discount) AS net_value
  FROM [BikeStores].[sales].[order_items]
WHERE quantity * list_price * (1 - discount)
      BETWEEN 19000 AND 25000
